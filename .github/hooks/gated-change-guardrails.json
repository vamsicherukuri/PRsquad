{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "tools": ["agent", "task"],
        "command": "node \"${PLUGIN_ROOT}/dist/hook-verify-gate.mjs\"",
        "timeoutSec": 15
      },
      {
        "tools": ["agent", "task"],
        "command": "node \"${PLUGIN_ROOT}/dist/hook-intake-ingest.mjs\"",
        "timeoutSec": 15
      },
      {
        "tools": ["edit", "edit_file", "write_to_file", "create_file"],
        "command": "node \"${PLUGIN_ROOT}/dist/hook-enforce-scope.mjs\"",
        "timeoutSec": 15
      },
      {
        "tools": ["bash", "execute", "terminal"],
        "command": "node \"${PLUGIN_ROOT}/dist/hook-sandbox-bash.mjs\"",
        "timeoutSec": 15
      }
    ]
  }
}
