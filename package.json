{
  "name": "gated-fix-pipeline",
  "version": "0.2.0",
  "private": true,
  "description": "GitHub Copilot App Enterprise Challenge submission - narrow slice: Issue -> Intake Triage -> Architect -> Scope gate",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check:plugin": "tsx scripts/check-plugin-consistency.ts",
    "gate:approve": "tsx scripts/guardrails/gate-approve.ts",
    "gate:reject": "tsx scripts/guardrails/gate-approve.ts --reject",
    "sweep": "tsx scripts/guardrails/ast-symbol-sweep.ts",
    "test:guardrails": "tsx scripts/test-guardrails.ts",
    "run:ready": "tsx src/orchestrator.ts examples/sample-issue-ready.json",
    "run:vague": "tsx src/orchestrator.ts examples/sample-issue-vague.json"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.14",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
