{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "tools": ["agent"],
        "command": "node --import tsx scripts/guardrails/hook-verify-gate.ts",
        "timeoutSec": 5
      },
      {
        "tools": ["agent"],
        "command": "node --import tsx scripts/guardrails/hook-intake-ingest.ts",
        "timeoutSec": 5
      },
      {
        "tools": ["edit"],
        "command": "node --import tsx scripts/guardrails/hook-enforce-scope.ts",
        "timeoutSec": 5
      },
      {
        "tools": ["bash"],
        "command": "node --import tsx scripts/guardrails/hook-sandbox-bash.ts",
        "timeoutSec": 5
      }
    ]
  }
}
