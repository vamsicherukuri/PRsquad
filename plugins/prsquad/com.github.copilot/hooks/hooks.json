{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node",
        "args": ["${PLUGIN_ROOT}/dist/run-hook.mjs", "hook-session-start"],
        "powershell": "node \"${PLUGIN_ROOT}/dist/run-hook.mjs\" hook-session-start",
        "timeoutSec": 20
      }
    ],
    "preToolUse": [
      {
        "tools": ["agent", "task"],
        "command": "node",
        "args": ["${PLUGIN_ROOT}/dist/run-hook.mjs", "hook-verify-gate"],
        "powershell": "node \"${PLUGIN_ROOT}/dist/run-hook.mjs\" hook-verify-gate",
        "timeoutSec": 60
      },
      {
        "tools": ["agent", "task"],
        "command": "node",
        "args": ["${PLUGIN_ROOT}/dist/run-hook.mjs", "hook-intake-ingest"],
        "powershell": "node \"${PLUGIN_ROOT}/dist/run-hook.mjs\" hook-intake-ingest",
        "timeoutSec": 15
      },
      {
        "tools": ["edit", "edit_file", "write_to_file", "create_file"],
        "command": "node",
        "args": ["${PLUGIN_ROOT}/dist/run-hook.mjs", "hook-enforce-scope"],
        "powershell": "node \"${PLUGIN_ROOT}/dist/run-hook.mjs\" hook-enforce-scope",
        "timeoutSec": 15
      },
      {
        "tools": ["bash", "execute", "terminal", "powershell"],
        "command": "node",
        "args": ["${PLUGIN_ROOT}/dist/run-hook.mjs", "hook-sandbox-bash"],
        "powershell": "node \"${PLUGIN_ROOT}/dist/run-hook.mjs\" hook-sandbox-bash",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "tools": ["agent", "task"],
        "command": "node",
        "args": ["${PLUGIN_ROOT}/dist/run-hook.mjs", "hook-verify-gate"],
        "powershell": "node \"${PLUGIN_ROOT}/dist/run-hook.mjs\" hook-verify-gate",
        "timeoutSec": 60
      }
    ]
  }
}
